# Supabase project (Project Settings → API)
NEXT_SUPABASE_URL=
# Publishable (anon) key — safe for the browser; RLS protects data.
NEXT_SUPABASE_ANON_KEY=
# Secret (service role) key — server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: canonical site URL for metadata, sitemap and robots (e.g. https://muhammadmusa.dev)
NEXT_PUBLIC_SITE_URL=
